{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrainLab Knowledge Base",
  "type": "object",
  "required": [
    "version",
    "updated",
    "collections",
    "sources",
    "records"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "path",
          "description"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "kind",
          "year",
          "access",
          "note",
          "reviewed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "access": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "reviewed": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "collection",
          "title",
          "summary",
          "sections",
          "source_ids",
          "relationships",
          "status",
          "aliases",
          "reviewed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "collection": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewed": {
            "type": "string",
            "format": "date"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "text": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "table": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target_id",
                "type",
                "label"
              ],
              "properties": {
                "target_id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "task-demand",
                    "research-context",
                    "see-also"
                  ]
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "demands": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": {
              "type": "object",
              "required": [
                "ability_id",
                "level"
              ],
              "properties": {
                "ability_id": {
                  "type": "string"
                },
                "level": {
                  "enum": [
                    0,
                    1,
                    2
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}